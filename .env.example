# Copy this file to .env and fill in what you need. .env is git-ignored. Never commit real keys.
#
# With no values at all, the app runs in local test mode with a mock model: no accounts needed.

# ---------------------------------------------------------------------------
# LaunchDarkly
# ---------------------------------------------------------------------------
# REPLACE: the server-side SDK key for the environment you demo in.
# Find it in LaunchDarkly under Settings, on the SDK keys page (project + environment specific).
# Setting it switches the app to live mode automatically.
LD_SDK_KEY=

# auto (default) = live if LD_SDK_KEY is set, otherwise local test flags. Or force: live | local
LD_MODE=auto

# Keys of the LaunchDarkly resources this app reads. Leave as-is if you used the README's keys.
FLAG_KEY=ai-incident-guidance
AGENT_CONFIG_KEY=incident-assistant
# Set to "off" to skip the judge (the code checks still run).
JUDGE_CONFIG_KEY=incident-policy-judge

# REPLACE: generic trigger URLs from the flag's "Configuration in environment" page.
# Treat them like passwords. OFF powers the "Roll back AI guidance" button, ON powers "Restore".
LD_TRIGGER_OFF_URL=
LD_TRIGGER_ON_URL=
# LaunchDarkly's trigger docs don't state the HTTP method. Webhooks are normally POST.
LD_TRIGGER_HTTP_METHOD=POST

# Optional: lets AgentControl Monitoring correlate traces. Not needed for the demo.
# LD_ENVIRONMENT_ID=

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# REPLACE (optional): an OpenAI API key.
OPENAI_API_KEY=

# auto (default) = openai in live mode when OPENAI_API_KEY is set, otherwise the mock model.
# Local test mode stays on the mock model unless you set LLM_MODE=openai here.
LLM_MODE=auto

# Local test mode with LLM_MODE=openai only: the OpenAI models the local configs should use.
# LOCAL_MODEL_SMALL=gpt-4o-mini
# LOCAL_MODEL_LARGE=gpt-4o

# ---------------------------------------------------------------------------
# Safety thresholds
# ---------------------------------------------------------------------------
# Answers scoring below this are blocked. The judge must return a score from 0 to 1.
JUDGE_PASS_THRESHOLD=0.7
AGENT_TIMEOUT_SECONDS=45
JUDGE_TIMEOUT_SECONDS=20

# Mock model only: simulated thinking time in milliseconds.
MOCK_LATENCY_MS=700

# ---------------------------------------------------------------------------
# Server and operator access
# ---------------------------------------------------------------------------
# The operator console (right side of the page) is open from this computer only by default.
# To use it from another machine, set HOST=0.0.0.0 and choose an OPERATOR_TOKEN. The console
# then asks for the token.
# HOST=127.0.0.1
# PORT=8000
# OPERATOR_TOKEN=
